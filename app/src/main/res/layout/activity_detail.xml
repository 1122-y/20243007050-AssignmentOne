<?xml version="1.0" encoding="utf-8"?>
<!--
    CampusLife - detail screen.

    A quarter height banner shows the topic icon and name, the rest of the
    screen scrolls the topic text. Both parts are weighted, so the screen
    scales with the device.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Topic banner -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/img_detail_banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/banner_content_description"
            android:scaleType="centerCrop"
            android:src="@drawable/img_main_banner" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/banner_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/detail_banner_padding">

            <ImageView
                android:id="@+id/img_detail_icon"
                android:layout_width="@dimen/detail_icon_size"
                android:layout_height="@dimen/detail_icon_size"
                android:contentDescription="@string/detail_icon_description"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_facilities" />

            <TextView
                android:id="@+id/txt_detail_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/topic_facilities"
                android:textColor="@color/white"
                android:textSize="@dimen/text_detail_title" />
        </LinearLayout>
    </FrameLayout>

    <!-- Scrolling topic text -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:background="@color/white"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/detail_content_padding">

            <TextView
                android:id="@+id/txt_detail_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/detail_heading_margin"
                android:gravity="center"
                android:text="@string/detail_heading_placeholder"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_detail_heading"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_detail_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="@dimen/detail_line_spacing"
                android:text="@string/detail_content_placeholder"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_detail_body" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
