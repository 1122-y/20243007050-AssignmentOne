<?xml version="1.0" encoding="utf-8"?>
<!--
    CampusLife - portrait home screen.

    The screen is split into two weighted bands: the banner takes 9/20 of the
    height and the topic grid takes the remaining 11/20. Inside the grid every
    row and every tile is also weighted, so the layout adapts to any screen
    size without a single fixed width or height.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Banner -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="9">

        <ImageView
            android:id="@+id/img_banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/banner_content_description"
            android:scaleType="centerCrop"
            android:src="@drawable/img_main_banner" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/banner_scrim" />

        <!-- 40sp is the single text size that the specification fixes. -->
        <TextView
            android:id="@+id/txt_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="@dimen/banner_text_padding"
            android:paddingEnd="@dimen/banner_text_padding"
            android:text="@string/banner_welcome"
            android:textColor="@color/white"
            android:textSize="40sp" />
    </FrameLayout>

    <!-- Topic grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="11"
        android:orientation="vertical"
        android:padding="@dimen/grid_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/tile_gap"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btn_facilities"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/button_selector"
                    android:contentDescription="@string/topic_facilities"
                    android:padding="@dimen/tile_icon_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_btn_facilities" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="@dimen/tile_label_margin"
                    android:text="@string/topic_facilities"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_tile_label" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/tile_gap"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btn_events"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/button_selector"
                    android:contentDescription="@string/topic_events"
                    android:padding="@dimen/tile_icon_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_btn_events" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="@dimen/tile_label_margin"
                    android:text="@string/topic_events"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_tile_label" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/tile_gap"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btn_clubs"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/button_selector"
                    android:contentDescription="@string/topic_clubs"
                    android:padding="@dimen/tile_icon_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_btn_clubs" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="@dimen/tile_label_margin"
                    android:text="@string/topic_clubs"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_tile_label" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/tile_gap"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btn_support"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/button_selector"
                    android:contentDescription="@string/topic_support"
                    android:padding="@dimen/tile_icon_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_btn_support" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="@dimen/tile_label_margin"
                    android:text="@string/topic_support"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_tile_label" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
